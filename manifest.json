{
  "manifest_version": 3,
  "name": "Clocked",
  "version": "1.0",
  "description": "Block websites after a set time limit — Clocked",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}